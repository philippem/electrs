{
  "title": "RocksDB",
  "uid": "electrs-rocksdb",
  "description": "RocksDB metrics from electrs (txstore_db, history_db, cache_db)",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["rocksdb", "electrs"],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": { "list": [] },

  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rocksdb_base_level, db)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {}
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "title": "Write Stopped",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rocksdb_is_write_stopped{db=~\"$db\"})",
          "legendFormat": "stopped"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1,    "color": "red" }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "STOPPED" } } }
          ]
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "title": "Delayed Write Rate",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rocksdb_actual_delayed_write_rate{db=~\"$db\"})",
          "legendFormat": "rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1,    "color": "yellow" }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "title": "Running Compactions",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rocksdb_num_running_compactions{db=~\"$db\"})",
          "legendFormat": "compactions"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "title": "Running Flushes",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rocksdb_num_running_flushes{db=~\"$db\"})",
          "legendFormat": "flushes"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "title": "L0 File Count (write-stall risk)",
      "description": "Number of SST files at L0. Write stalls trigger at the level0_slowdown_writes_trigger (default 20) and stop at level0_stop_writes_trigger (default 36). During initial sync these triggers are disabled.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_num_files_at_level{db=~\"$db\", level=\"0\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 6,
      "title": "Files per Level",
      "description": "Number of SST files at each compaction level across all selected databases.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_num_files_at_level{db=~\"$db\"}",
          "legendFormat": "{{db}} L{{level}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 7,
      "title": "Pending Compaction Bytes",
      "description": "Estimated bytes that still need to be compacted. High values indicate compaction is falling behind writes.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_estimate_pending_compaction_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 8,
      "title": "Memtable Size",
      "description": "Total size of active + immutable memtables. When this is large, a flush is imminent.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_size_all_mem_tables_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} all"
        },
        {
          "refId": "B",
          "expr": "rocksdb_cur_size_active_mem_table_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} active"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 9,
      "title": "Immutable Memtables",
      "description": "Number of immutable (flushed-pending) memtables. A high count means flushing is slow.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_num_immutable_mem_table{db=~\"$db\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 10,
      "title": "Block Cache Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_block_cache_capacity_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} capacity"
        },
        {
          "refId": "B",
          "expr": "rocksdb_block_cache_usage_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} used"
        },
        {
          "refId": "C",
          "expr": "rocksdb_block_cache_pinned_usage_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} pinned"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 11,
      "title": "SST File Size",
      "description": "Total vs live SST file sizes. Total includes obsolete files not yet deleted; live is what actually matters.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_total_sst_files_size_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} total"
        },
        {
          "refId": "B",
          "expr": "rocksdb_live_sst_files_size_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}} live"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 12,
      "title": "Estimated Key Count",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_estimate_num_keys{db=~\"$db\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 13,
      "title": "Estimated Live Data Size",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_estimate_live_data_size_bytes{db=~\"$db\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },

    {
      "id": 14,
      "title": "Background Errors",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rocksdb_background_errors_total{db=~\"$db\"}",
          "legendFormat": "{{db}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1,    "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    }

  ]
}
